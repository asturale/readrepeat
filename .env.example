# Verplicht
SESSION_SECRET=verander-dit-in-iets-lang-en-willekeurigs

# Optioneel: automatische cover/auteur-verrijking via Hardcover's API.
# Zonder token valt het systeem terug op Open Library voor covers.
HARDCOVER_API_TOKEN=

# Optioneel: webpush-herinneringen. Genereer een sleutelpaar met:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jouw@email.nl

# Optional: Sign in with SSO (OpenID Connect), see README
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=readrepeat
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://readrepeat.example.com/auth/oidc/callback
# OIDC_PROVIDER_NAME=SSO
# PASSWORD_LOGIN=true
# OIDC_LINK_BY_USERNAME=false

# Optional: footer text on share images (default: ReadRepeat)
# SHARE_WATERMARK=readrepeat.example.com
