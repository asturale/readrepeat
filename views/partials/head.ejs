<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ReadRepeat' : 'ReadRepeat' %></title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon.png">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<meta name="theme-color" content="#0f1720">
<style>
  :root {
    color-scheme: dark;
    --bg: #0f1720;
    --surface: #17212c;
    --surface-hover: #1e2a38;
    --border: #263242;
    --text: #eef2f7;
    --text-dim: #9fb0c3;
    --text-faint: #6b7a8d;
    --accent: #4f8cff;
    --accent-hover: #6ea0ff;
    --accent-dim: rgba(79,140,255,0.15);
    --danger: #e5484d;
    --danger-dim: rgba(229,72,77,0.15);
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --shadow: 0 1px 3px rgba(0,0,0,0.3), 0 4px 12px rgba(0,0,0,0.15);
    --text-scale: <%= typeof textScale !== 'undefined' ? textScale : 1 %>;
  }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); margin: 0; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-hover); }
  h1, h2, h3 { font-weight: 700; letter-spacing: -0.01em; }

  header.topbar { position: sticky; top: 0; z-index: 10; padding: 0.7em 1.5em; background: rgba(23,33,44,0.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  header.topbar .topbar-row { display: flex; align-items: center; justify-content: space-between; gap: 1em; height: 2.6em; }
  header.topbar .brand { display: flex; align-items: center; gap: 0.5em; font-weight: 800; font-size: 1.1em; color: var(--text); flex-shrink: 0; }
  header.topbar .brand img { width: 2em; height: 2em; border-radius: 7px; display: block; }
  header.topbar nav { display: flex; align-items: center; gap: 0.3em; height: 100%; }
  header.topbar nav a { display: flex; align-items: center; justify-content: center; width: 2.6em; height: 2.6em; border-radius: 50%; flex-shrink: 0; }
  header.topbar nav a img { width: 1.5em; height: 1.5em; display: block; }
  header.topbar nav a:hover { background: var(--surface-hover); }
  header.topbar .search-box { position: relative; margin-top: 0.7em; }
  header.topbar .search-box input { width: 100%; padding: 0.5em 0.8em 0.5em 2.2em; }
  header.topbar .search-box::before { content: '🔍'; position: absolute; left: 0.7em; top: 50%; transform: translateY(-50%); font-size: 0.85em; opacity: 0.55; pointer-events: none; }

  main { max-width: 900px; margin: 0 auto; padding: 2em 1.5em 4em; }
  .page-title { font-size: 1.6em; margin: 0 0 0.25em; }
  .page-sub { color: var(--text-dim); margin: 0 0 1.6em; font-size: 0.95em; }

  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5em; margin-bottom: 1em; }

  .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1.4em; }
  .book-grid a { text-decoration: none; color: inherit; display: block; transition: transform 0.15s ease; }
  .book-grid a:hover { transform: translateY(-3px); }
  .book-cover { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: var(--radius-md); background: var(--surface-hover); display: flex; align-items: center; justify-content: center; font-size: 0.8em; color: var(--text-faint); text-align: center; padding: 0.6em; box-shadow: var(--shadow); border: 1px solid var(--border); transition: box-shadow 0.15s ease; }
  .book-grid a:hover .book-cover { box-shadow: 0 8px 24px rgba(0,0,0,0.45); }
  .book-title { font-size: 0.92em; margin-top: 0.5em; font-weight: 600; line-height: 1.3; }
  .book-author { font-size: 0.8em; color: var(--text-dim); }
  .book-count { font-size: 0.75em; color: var(--text-faint); margin-top: 0.15em; }

  .highlight { border-left: 3px solid var(--text-faint); border-top: 1px solid var(--border); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 0.9em 1.1em; margin-bottom: 0.9em; background: var(--surface); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .highlight.color-yellow { border-left-color: #e0c419; }
  .highlight.color-blue { border-left-color: #4a90d9; }
  .highlight.color-pink { border-left-color: #d94a90; }
  .highlight.color-green { border-left-color: #4ad98c; }
  .highlight:target { outline: 2px solid var(--accent); outline-offset: 2px; animation: highlight-flash 1.8s ease-out; }
  @keyframes highlight-flash { 0% { background: var(--accent-dim); } 100% { background: var(--surface); } }
  .highlight-chapter { font-size: 0.72em; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5em; font-weight: 600; }
  .highlight-text { line-height: 1.55; }
  .md-mark { background: rgba(224,196,25,0.35); color: inherit; border-radius: 3px; padding: 0 0.15em; }
  .md-image { max-width: 100%; border-radius: var(--radius-sm); margin: 0.5em 0; display: block; }
  .highlight-note { margin-top: 0.6em; font-size: 0.9em; color: var(--text-dim); font-style: italic; }
  .highlight-meta { font-size: 0.75em; color: var(--text-faint); margin-top: 0.55em; }
  .highlight-tags { margin-top: 0.6em; display: flex; gap: 0.4em; flex-wrap: wrap; }
  .tag-pill { font-size: 0.72em; background: var(--accent-dim); color: var(--accent-hover); padding: 0.2em 0.6em; border-radius: 999px; font-weight: 600; }
  .heading-divider { display: flex; align-items: center; gap: 0.8em; margin: 1.8em 0 1em; color: var(--text-dim); font-weight: 700; font-size: 0.95em; }
  .heading-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  input, textarea, select, button { font-size: 0.95em; padding: 0.55em 0.85em; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg); color: var(--text); font-family: inherit; }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }
  button { cursor: pointer; border: 1px solid transparent; font-weight: 600; transition: background 0.15s, opacity 0.15s; }
  button { background: var(--accent); color: #fff; }
  button:hover { background: var(--accent-hover); }
  button.secondary { background: var(--surface-hover); color: var(--text); border-color: var(--border); }
  button.secondary:hover { background: var(--border); }
  button.danger { background: var(--danger-dim); color: #ff9a9d; border-color: transparent; }
  button.danger:hover { background: var(--danger); color: #fff; }

  form.stacked label { display: block; margin: 0.9em 0 0.35em; font-size: 0.88em; color: var(--text-dim); font-weight: 600; }
  form.stacked input, form.stacked textarea { width: 100%; }

  .error { background: var(--danger-dim); border: 1px solid var(--danger); padding: 0.9em 1.1em; border-radius: var(--radius-md); margin-bottom: 1em; color: #ffb3b5; }
  .center-form { max-width: 380px; margin: 4em auto; }
  .center-form h1 { text-align: center; }

  code.token { display: block; background: var(--bg); padding: 0.9em; border-radius: var(--radius-md); word-break: break-all; margin: 0.6em 0; border: 1px solid var(--border); font-size: 0.85em; }

  table { width: 100%; border-collapse: collapse; }
  td, th { text-align: left; padding: 0.6em 0.4em; border-bottom: 1px solid var(--border); font-size: 0.88em; }
  th { color: var(--text-faint); font-weight: 600; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.03em; }

  .empty-state { text-align: center; padding: 3em 1.5em; color: var(--text-dim); }
  .empty-state h2 { color: var(--text); margin-bottom: 0.4em; }

  .account-menu { padding: 0; overflow: hidden; }
  .account-menu a { display: flex; justify-content: space-between; align-items: center; padding: 1em 1.3em; color: var(--text); border-bottom: 1px solid var(--border); font-weight: 600; }
  .account-menu a:last-child { border-bottom: none; }
  .account-menu a:hover { background: var(--surface-hover); }
  .account-menu a span:last-child { color: var(--text-faint); font-weight: 400; }

  .hero-review { text-align: center; padding: 2.2em 1.5em; background: linear-gradient(180deg, var(--surface-hover), var(--surface)); }
  .hero-covers { position: relative; height: 130px; margin-bottom: 1.3em; display: flex; align-items: center; justify-content: center; }
  .hero-covers img { position: absolute; width: 76px; aspect-ratio: 2/3; object-fit: cover; border-radius: 6px; box-shadow: 0 10px 24px rgba(0,0,0,0.5); border: 1px solid var(--border); }
  .hero-covers img:nth-child(1) { transform: rotate(-12deg) translateX(-40px); z-index: 1; }
  .hero-covers img:nth-child(2) { transform: rotate(0deg) translateY(-6px); z-index: 2; }
  .hero-covers img:nth-child(3) { transform: rotate(12deg) translateX(40px); z-index: 1; }
  .hero-covers-placeholder { font-size: 3em; }
  .hero-review h2 { margin: 0 0 0.3em; font-size: 1.4em; }
  .hero-subtitle { color: var(--text-dim); margin: 0 0 1.3em; font-size: 0.92em; }
  .hero-review-btn { width: 100%; max-width: 280px; padding: 0.85em; border-radius: 999px; font-size: 1.05em; }

  .feed-item { display: flex; gap: 0.9em; padding: 0.9em 0; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; }
  .feed-item:last-child { border-bottom: none; }
  .feed-cover { width: 42px; aspect-ratio: 2/3; object-fit: cover; border-radius: 4px; flex-shrink: 0; background: var(--surface-hover); }
  .feed-book { font-size: 0.76em; color: var(--text-faint); font-weight: 600; margin-bottom: 0.3em; text-transform: uppercase; letter-spacing: 0.03em; }
  .feed-text { font-size: 0.92em; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
</head>
<body>
<script>
  // Registering the service worker (with no push subscription) is enough
  // for PWA installability -- push itself is opt-in via Account > Settings.
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
</script>
