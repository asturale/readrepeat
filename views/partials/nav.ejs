<header class="topbar">
  <div class="topbar-row">
    <a class="brand" href="/"><img src="/icons/icon-192.png" alt="">ReadRepeat</a>
    <% if (user) { %>
    <nav>
      <a href="/books" title="<%= t('nav.books') %>"><img src="/icons/nav-highlights.png" alt=""></a>
      <a href="/review" title="<%= t('nav.review') %>"><img src="/icons/nav-review.png" alt=""></a>
      <a href="/account" title="<%= t('nav.account') %>"><img src="/icons/nav-account.png" alt=""></a>
    </nav>
    <% } %>
  </div>
  <% if (user) { %>
  <form method="get" action="/search" class="search-box">
    <input type="search" name="q" placeholder="<%= t('nav.search_placeholder') %>" value="<%= typeof q !== 'undefined' ? q : '' %>">
  </form>
  <% } %>
</header>
