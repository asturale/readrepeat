<% var title = t('books.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main>
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.6em;">
    <h1 class="page-title" style="margin:0;"><%= t('books.heading') %></h1>
    <select onchange="location.href='/books?sort='+this.value" style="width:auto;">
      <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>><%= t('books.sort_recent') %></option>
      <option value="title" <%= sort === 'title' ? 'selected' : '' %>><%= t('books.sort_title') %></option>
      <option value="author" <%= sort === 'author' ? 'selected' : '' %>><%= t('books.sort_author') %></option>
      <option value="highlights" <%= sort === 'highlights' ? 'selected' : '' %>><%= t('books.sort_highlights') %></option>
    </select>
  </div>
  <p class="page-sub"><%= t('dashboard.stats', { count: totalHighlights, books: books.length }) %></p>
  <% if (books.length === 0) { %>
    <div class="empty-state card">
      <h2><%= t('dashboard.empty_title') %></h2>
      <p><%= t('dashboard.empty_body') %> <a href="/account"><%= t('dashboard.empty_link') %></a>.</p>
    </div>
  <% } else { %>
  <p>
    <button type="button" id="merge-books-btn" class="secondary" disabled><%= t('books.merge_selected') %></button>
  </p>
  <div class="book-grid">
    <% books.forEach(function(b) { %>
    <div class="book-card">
      <input type="checkbox" class="book-select" value="<%= b.id %>" title="<%= t('books.select_for_merge') %>">
      <input type="radio" name="survivor" class="book-survivor" value="<%= b.id %>" title="<%= t('books.keep_this_metadata') %>">
      <a href="/books/<%= b.id %>">
        <% if (b.cover_url) { %>
          <img class="book-cover" src="<%= b.cover_url %>" alt="">
        <% } else { %>
          <div class="book-cover"><%= b.title %></div>
        <% } %>
        <div class="book-title"><%= b.title %></div>
        <% if (b.author) { %><div class="book-author"><%= b.author %></div><% } %>
        <div class="book-count"><%= b.highlight_count %> <%= t(b.highlight_count === 1 ? 'highlight_count_one' : 'highlight_count_other') %></div>
      </a>
    </div>
    <% }) %>
  </div>
  <% } %>
</main>
<script>
  // Checkboxes deliberately sit OUTSIDE each <a> (siblings, not nested) --
  // an interactive control inside a big clickable link either steals the
  // navigation click or gets swallowed by it depending on the browser.
  const mergeBtn = document.getElementById('merge-books-btn');
  const boxes = () => [...document.querySelectorAll('.book-select')];
  const radios = () => [...document.querySelectorAll('.book-survivor')];
  if (mergeBtn) {
    boxes().forEach((box) => box.addEventListener('change', () => {
      mergeBtn.disabled = boxes().filter((b) => b.checked).length < 2;
      // Een radio voor een uitgevinkt boek is zinloos (en verwarrend) -- die
      // hoort dan zelf ook uit te gaan, geen impliciete survivor meer.
      if (!box.checked) {
        const r = radios().find((rr) => rr.value === box.value);
        if (r) r.checked = false;
      }
    }));
    mergeBtn.onclick = () => {
      const ids = boxes().filter((b) => b.checked).map((b) => b.value);
      if (ids.length < 2) return;
      if (!confirm(<%- JSON.stringify(t('books.merge_confirm')) %>)) return;
      const form = document.createElement('form');
      form.method = 'post';
      form.action = '/books/merge';
      const survivor = radios().find((r) => r.checked && ids.includes(r.value));
      if (survivor) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'survivor_id';
        input.value = survivor.value;
        form.appendChild(input);
      }
      for (const id of ids) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'ids';
        input.value = id;
        form.appendChild(input);
      }
      document.body.appendChild(form);
      form.submit();
    };
  }
</script>
<%- include('partials/back-to-top') %>
</body>
</html>
