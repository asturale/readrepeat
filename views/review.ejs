<% var title = t('review.title') %>
<%- include('partials/head', { title }) %>
<style>
  /* Own the whole vertical layout as a flex column (topbar / card-area /
     fixed bottombar) so the card centers in the space ACTUALLY left over,
     not an arbitrary fraction of the viewport -- that used to leave a big
     dead gap above/below short highlights. */
  body { display:flex; flex-direction:column; min-height:100vh; }
  .review-topbar { flex-shrink:0; display:flex; align-items:center; justify-content:space-between; padding:1em 1.2em; }
  .review-topbar button { background:none; border:none; color:var(--text); font-size:1.4em; cursor:pointer; padding:0.2em 0.5em; border-radius:50%; }
  .review-topbar button:hover { background:var(--surface-hover); }
  .review-dots { display:flex; gap:6px; }
  .review-dots span { width:7px; height:7px; border-radius:50%; background:var(--border); display:inline-block; }
  .review-dots span.done { background:var(--text-faint); }
  .review-dots span.current { background:var(--text); }

  main { flex:1; display:flex; flex-direction:column; padding:1em 1.2em 8em; }
  .review-card-wrap { flex:1; display:flex; flex-direction:column; justify-content:center; }
  .review-card { max-width:640px; width:100%; margin:0 auto; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); box-shadow:var(--shadow); padding:1.8em 1.6em; touch-action:pan-y; }
  .review-card .book-line { font-size:0.85em; color:var(--text-dim); margin-bottom:1.2em; }
  .review-card .text { font-family: Georgia, 'Times New Roman', serif; font-size:calc(1.4rem * var(--text-scale)); line-height:1.5; color:var(--text); }
  .review-card .note { margin-top:1em; font-size:0.95em; color:var(--text-dim); font-style:italic; }
  .review-card .card-icons { display:flex; gap:1em; margin-top:1.5em; padding-top:1.1em; border-top:1px solid var(--border); }
  .review-card .card-icons button { display:flex; align-items:center; justify-content:center; background:none; border:none; color:var(--text-faint); cursor:pointer; padding:0.3em; line-height:0; }
  .review-card .card-icons button:hover { color:var(--text); }
  .review-card .card-icons svg { width:1.15em; height:1.15em; display:block; }

  .review-bottombar { position:fixed; bottom:0; left:0; right:0; background:var(--bg); border-top:1px solid var(--border); padding:1em 1em 1.6em; display:flex; justify-content:center; gap:0.5em; flex-wrap:nowrap; }
  .pill-action { flex:1; min-width:0; display:flex; align-items:center; justify-content:center; gap:0.4em; padding:0.75em 0.5em; border-radius:999px; font-weight:600; font-size:0.85em; cursor:pointer; border:none; white-space:nowrap; }
  .pill-action .pill-icon { font-size:1.1em; flex-shrink:0; }
  .pill-action.discard, .pill-action.freq { background:var(--surface-hover); color:var(--text); }
  .pill-action.keep { background:var(--accent); color:#fff; }

  .freq-menu { position:fixed; bottom:110px; left:50%; transform:translateX(-50%); background:var(--surface-hover); border-radius:12px; padding:0.5em; display:none; flex-direction:column; gap:0.3em; box-shadow:0 10px 30px rgba(0,0,0,0.4); border:1px solid var(--border); }
  .freq-menu.open { display:flex; }
  .freq-menu button { background:none; border:none; color:var(--text); padding:0.6em 1.2em; text-align:left; border-radius:8px; cursor:pointer; }
  .freq-menu button:hover { background:var(--bg); }
  .review-empty { max-width:480px; margin:auto; text-align:center; }
</style>
</head>
<body>
  <div class="review-topbar">
    <button onclick="location.href='/'">✕</button>
    <div class="review-dots" id="dots"></div>
    <div style="width:2.4em"></div>
  </div>

  <main>
    <% if (batch.length === 0) { %>
    <div class="review-empty">
      <h2><%= t('review.empty_heading') %></h2>
      <p style="color:var(--text-dim)"><%= t('review.empty_body') %></p>
      <p><a href="/">&larr; <%= t('review.back') %></a></p>
    </div>
    <% } else { %>
    <div class="review-card-wrap">
      <div class="review-card" id="card"></div>
    </div>
    <% } %>
  </main>

  <% if (batch.length > 0) { %>
  <div class="freq-menu" id="freq-menu">
    <button data-action="more"><%= t('review.more') %></button>
    <button data-action="less"><%= t('review.less') %></button>
  </div>
  <div class="review-bottombar">
    <button class="pill-action discard" id="btn-discard"><span class="pill-icon">✕</span><%= t('review.discard') %></button>
    <button class="pill-action freq" id="btn-freq"><span class="pill-icon">↕</span><%= t('review.frequency') %></button>
    <button class="pill-action keep" id="btn-keep"><span class="pill-icon">✓</span><%= t('review.next') %></button>
  </div>
  <% } %>

  <script>
    // Escape "<" so a highlight/note containing a literal script-closing
    // tag can never break out of this inline script block (JSON.stringify
    // alone does NOT do this). NOTE: never spell that closing tag out
    // literally in this comment either -- the HTML parser looks for the
    // raw byte sequence regardless of JS syntax, even inside a // comment,
    // and would cut the whole script block off right here.
    // text/note/book_title/book_author arrive PRE-RENDERED to safe HTML via
    // md() (escapes first, then adds a fixed set of safe tags -- see
    // lib/markdown.js) so the client just drops them straight into
    // innerHTML below, no client-side escaping needed for those fields.
    const batch = <%- JSON.stringify(batch.map(h => ({
        id: h.id, textHtml: md(h.text), noteHtml: h.note ? md(h.note) : null,
        bookTitleHtml: md(h.book_title), bookAuthorHtml: h.book_author ? md(h.book_author) : null,
        book_id: h.book_id,
    }))).replace(/</g, '\\u003c') %>;
    const S = <%- JSON.stringify({
        doneHeading: t('review.done_heading'), doneBody: t('review.done_body'), back: t('review.back'),
        discardConfirm: t('review.discard_confirm'), shareTitle: t('review.share_title'), bookTitle: t('review.book_title'),
    }).replace(/</g, '\\u003c') %>;
    let i = 0;

    // Flat, monochrome (currentColor) icons matching the app's theme --
    // plain emoji here rendered misaligned/full-color and clashed with the
    // rest of the UI.
    const ICON_SHARE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 8l5-5 5 5"/><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>';
    const ICON_BOOK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>';

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s || '';
      return d.innerHTML;
    }

    function renderDots() {
      document.getElementById('dots').innerHTML = batch
        .map((_, idx) => `<span class="${idx < i ? 'done' : idx === i ? 'current' : ''}"></span>`)
        .join('');
    }

    function renderCard() {
      if (i >= batch.length) {
        // Only reached after a non-empty batch was fully gone through --
        // this IS "did a review session today" for the dashboard's
        // "Klaar voor vandaag" card. Fire-and-forget: never block the
        // done-screen on it.
        fetch('/review/session/complete', { method: 'POST' }).catch(() => {});
        document.querySelector('main').innerHTML =
          '<div class="review-empty"><h2>' + esc(S.doneHeading) + '</h2><p style="color:var(--text-dim)">' + esc(S.doneBody) + '</p><p><a href="/">&larr; ' + esc(S.back) + '</a></p></div>';
        document.querySelector('.review-bottombar')?.remove();
        document.getElementById('freq-menu')?.remove();
        return;
      }
      const h = batch[i];
      const card = document.getElementById('card');
      card.innerHTML =
        '<div class="book-line">' + h.bookTitleHtml + (h.bookAuthorHtml ? ' — ' + h.bookAuthorHtml : '') + '</div>' +
        '<div class="text">' + h.textHtml + '</div>' +
        (h.noteHtml ? '<div class="note">📝 ' + h.noteHtml + '</div>' : '') +
        '<div class="card-icons">' +
        '<button title="' + esc(S.shareTitle) + '" id="btn-share">' + ICON_SHARE + '</button>' +
        '<button title="' + esc(S.bookTitle) + '" id="btn-book">' + ICON_BOOK + '</button>' +
        '</div>';
      card.style.transition = 'none';
      card.style.transform = '';
      card.style.opacity = '';
      document.getElementById('btn-book').onclick = () => location.href = '/books/' + h.book_id;
      document.getElementById('btn-share').onclick = () => location.href = '/highlights/' + h.id + '/share';
      renderDots();
    }

    // Swipe (either direction) on the card advances to the next highlight,
    // same as tapping "Volgende" -- listeners attach once since #card is
    // reused across renders (only its innerHTML changes).
    function attachSwipe() {
      const card = document.getElementById('card');
      if (!card) return;
      let startX = null;
      let startY = null;
      let currentX = null;
      // Undecided until the finger has moved enough to tell a horizontal
      // swipe apart from a vertical scroll -- prevents the card from
      // wobbling left/right on ordinary up/down scrolling (only the
      // incidental sideways jitter of a vertical drag was driving it).
      let isHorizontal = null;
      card.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        currentX = startX;
        isHorizontal = null;
        card.style.transition = 'none';
      }, { passive: true });
      card.addEventListener('touchmove', (e) => {
        if (startX === null) return;
        currentX = e.touches[0].clientX;
        const dx = currentX - startX;
        const dy = e.touches[0].clientY - startY;
        if (isHorizontal === null) {
          if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return; // not enough movement to decide yet
          isHorizontal = Math.abs(dx) > Math.abs(dy);
        }
        if (!isHorizontal) return; // vertical scroll -- leave the card alone
        card.style.transform = `translateX(${dx}px) rotate(${dx / 20}deg)`;
        card.style.opacity = String(Math.max(1 - Math.abs(dx) / 300, 0.4));
      }, { passive: true });
      card.addEventListener('touchend', () => {
        if (startX === null) return;
        const dx = currentX - startX;
        const wasHorizontal = isHorizontal;
        startX = null;
        if (!wasHorizontal) return; // was a vertical scroll -- nothing to animate/act on
        card.style.transition = 'transform 0.2s ease, opacity 0.2s ease';
        if (Math.abs(dx) > 80) {
          card.style.transform = `translateX(${dx > 0 ? 1 : -1}00%) rotate(${dx > 0 ? 15 : -15}deg)`;
          card.style.opacity = '0';
          // Right = back to the previous card (just re-view it, no new
          // POST -- its schedule from last time stays as-is). Left = same
          // as "Volgende": records the review and advances.
          if (dx > 0) setTimeout(goBack, 150);
          else setTimeout(() => act('next'), 150);
        } else {
          card.style.transform = '';
          card.style.opacity = '';
        }
      });
    }

    function goBack() {
      if (i > 0) i--;
      renderCard();
    }

    async function act(action) {
      const h = batch[i];
      await fetch('/review/' + h.id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'action=' + encodeURIComponent(action),
      });
      i++;
      renderCard();
    }

    if (batch.length > 0) {
      renderCard();
      attachSwipe();
      document.getElementById('btn-keep').onclick = () => act('next');
      document.getElementById('btn-discard').onclick = () => {
        if (confirm(S.discardConfirm)) act('stop');
      };
      const freqMenu = document.getElementById('freq-menu');
      document.getElementById('btn-freq').onclick = () => freqMenu.classList.toggle('open');
      freqMenu.querySelectorAll('button').forEach((btn) => {
        btn.onclick = () => { freqMenu.classList.remove('open'); act(btn.dataset.action); };
      });
    }
  </script>
</body>
</html>
