<% var title = t('dashboard.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main>
  <% if (streak > 0) { %>
  <div style="display:flex; justify-content:flex-end; margin-bottom:0.6em;">
    <div class="streak-badge" title="<%= t('dashboard.streak', { count: streak }) %>">🔥 <%= streak %></div>
  </div>
  <% } %>
  <% if (reviewPreview) { %>
  <% var authorsText = reviewPreview.authors.length > 0 ? reviewPreview.authors.join(', ') + ', ' + t('dashboard.and_more') : '' %>
  <div class="card hero-review">
    <div class="hero-covers">
      <% if (reviewPreview.covers.length > 0) { %>
        <% reviewPreview.covers.forEach(function(c) { %>
          <img src="<%= c %>" alt="">
        <% }) %>
      <% } else { %>
        <div class="hero-covers-placeholder">🖍️</div>
      <% } %>
    </div>
    <% if (reviewDone) { %>
      <h2><%= t('dashboard.review_done_heading') %></h2>
      <p class="hero-subtitle"><%= t('dashboard.review_done_subtitle') %></p>
      <a href="/review?ids=<%= reviewBatchIds %>"><button class="hero-review-btn secondary"><%= t('dashboard.review_more_button') %></button></a>
    <% } else { %>
      <h2><%= t('dashboard.daily_review') %></h2>
      <p class="hero-subtitle">
        <% if (authorsText) { %><%= t('dashboard.review_subtitle', { count: reviewSessionCount, authors: authorsText }) %><% } else { %><%= t('dashboard.to_review', { count: reviewSessionCount }) %><% } %>
      </p>
      <a href="/review?ids=<%= reviewBatchIds %>"><button class="hero-review-btn"><%= t('dashboard.review_button') %></button></a>
    <% } %>
  </div>
  <% } %>

  <p class="page-sub">
    <%= t('dashboard.stats', { count: totalHighlights, books: bookCount }) %>
  </p>

  <% if (bookCount === 0) { %>
    <div class="empty-state card">
      <h2><%= t('dashboard.empty_title') %></h2>
      <p><%= t('dashboard.empty_body') %> <a href="/account"><%= t('dashboard.empty_link') %></a>.</p>
    </div>
  <% } else if (recentHighlights.length > 0) { %>
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.6em; margin-top:1em;">
    <h2 style="margin:0;"><%= t('dashboard.feed_heading') %></h2>
    <div class="feed-sort-toggle">
      <a href="/?feed=recent" class="<%= feedMode === 'recent' ? 'active' : '' %>"><%= t('dashboard.feed_recent') %></a>
      <a href="/?feed=random" class="<%= feedMode === 'random' ? 'active' : '' %>"><%= t('dashboard.feed_random') %></a>
      <a href="/?feed=oldest" class="<%= feedMode === 'oldest' ? 'active' : '' %>"><%= t('dashboard.feed_oldest') %></a>
    </div>
  </div>
  <div class="card" style="padding:0 1.5em;">
    <% recentHighlights.forEach(function(h) { %>
    <a href="/review?ids=<%= h.id %>" class="feed-item">
      <% if (h.cover_url) { %>
        <img class="feed-cover" src="<%= h.cover_url %>" alt="">
      <% } else { %>
        <div class="feed-cover"></div>
      <% } %>
      <div style="min-width:0;">
        <div class="feed-book"><%= h.book_title %></div>
        <div class="feed-text"><%- md(h.text) %></div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</main>
</body>
</html>
