<% var title = t('account.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main>
  <h1 class="page-title"><%= t('account.title') %></h1>
  <div class="card account-menu">
    <a href="/account/settings"><span>⚙️ <%= t('account.settings_link') %></span> <span>→</span></a>
    <a href="/about"><span>ℹ️ <%= t('account.about_link') %></span> <span>→</span></a>
  </div>

  <div class="card">
    <h2 style="margin-top:0; display:flex; align-items:center; gap:0.5em;">
      <%= t('account.streak_heading') %>
      <% if (streak > 0) { %><span class="streak-badge">🔥 <%= streak %></span><% } %>
    </h2>
    <% if (streak === 0) { %><p style="color:var(--text-dim)"><%= t('account.streak_none') %></p><% } %>
    <p style="color:var(--text-faint); font-size:0.85em; text-transform:capitalize; margin-bottom:0.6em;"><%= calendarLabel %></p>
    <div class="streak-calendar">
      <% calendarMonth.forEach(function(d) { %>
      <div class="streak-day <%= d.done ? 'done' : '' %> <%= d.isToday ? 'today' : '' %>"><%= d.day %></div>
      <% }) %>
    </div>
  </div>

  <form method="post" action="/logout">
    <button type="submit" class="secondary"><%= t('nav.logout') %></button>
  </form>
</main>
</body>
</html>
