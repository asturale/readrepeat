<% var title = q ? `${t('search.title')}: ${q}` : t('search.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav', { q }) %>
<main>
  <h1 class="page-title"><%= t('search.heading') %><% if (q) { %>: "<%= q %>"<% } %></h1>

  <% if (!q) { %>
  <div class="empty-state card"><%= t('search.hint') %></div>
  <% } else if (results.books.length === 0 && results.highlights.length === 0) { %>
  <div class="empty-state card"><%= t('search.no_results') %></div>
  <% } else { %>

  <% if (results.books.length > 0) { %>
  <h2><%= t('search.books_heading') %></h2>
  <% if (results.books.length > 1) { %>
  <p>
    <button type="button" id="merge-books-btn" class="secondary" disabled><%= t('books.merge_selected') %></button>
  </p>
  <% } %>
  <div class="book-grid" style="margin-bottom:2em;">
    <% results.books.forEach(function(b) { %>
    <div class="book-card">
      <% if (results.books.length > 1) { %><input type="checkbox" class="book-select" value="<%= b.id %>" title="<%= t('books.select_for_merge') %>"><input type="radio" name="survivor" class="book-survivor" value="<%= b.id %>" title="<%= t('books.keep_this_metadata') %>"><% } %>
      <a href="/books/<%= b.id %>">
        <% if (b.cover_url) { %>
          <img class="book-cover" src="<%= b.cover_url %>" alt="">
        <% } else { %>
          <div class="book-cover"><%= b.title %></div>
        <% } %>
        <div class="book-title"><%= b.title %></div>
        <% if (b.author) { %><div class="book-author"><%= b.author %></div><% } %>
        <div class="book-count"><%= b.highlight_count %> <%= t(b.highlight_count === 1 ? 'highlight_count_one' : 'highlight_count_other') %></div>
      </a>
    </div>
    <% }) %>
  </div>
  <% } %>

  <% if (results.highlights.length > 0) { %>
  <h2><%= t('search.highlights_heading') %></h2>
  <% results.highlights.forEach(function(h) { %>
  <a href="/books/<%= h.book_id %>" style="text-decoration:none; color:inherit; display:block;">
    <div class="highlight <%= h.color ? 'color-' + h.color : '' %>">
      <div style="font-size:0.85em; color:var(--text-dim)"><%= h.book_title %><% if (h.book_author) { %> — <%= h.book_author %><% } %></div>
      <div class="highlight-text" style="margin-top:0.4em"><%- md(h.text) %></div>
      <% if (h.note) { %><div class="highlight-note">📝 <%- md(h.note) %></div><% } %>
    </div>
  </a>
  <% }) %>
  <% } %>

  <% } %>
</main>
<% if (results.books.length > 1) { %>
<script>
  // Same pattern as /books: checkboxes sit OUTSIDE each <a> (siblings, not
  // nested) so they don't fight the card's own click-to-navigate.
  const mergeBtn = document.getElementById('merge-books-btn');
  const boxes = () => [...document.querySelectorAll('.book-select')];
  const radios = () => [...document.querySelectorAll('.book-survivor')];
  if (mergeBtn) {
    boxes().forEach((box) => box.addEventListener('change', () => {
      mergeBtn.disabled = boxes().filter((b) => b.checked).length < 2;
      if (!box.checked) {
        const r = radios().find((rr) => rr.value === box.value);
        if (r) r.checked = false;
      }
    }));
    mergeBtn.onclick = () => {
      const ids = boxes().filter((b) => b.checked).map((b) => b.value);
      if (ids.length < 2) return;
      if (!confirm(<%- JSON.stringify(t('books.merge_confirm')) %>)) return;
      const form = document.createElement('form');
      form.method = 'post';
      form.action = '/books/merge';
      const survivor = radios().find((r) => r.checked && ids.includes(r.value));
      if (survivor) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'survivor_id';
        input.value = survivor.value;
        form.appendChild(input);
      }
      for (const id of ids) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'ids';
        input.value = id;
        form.appendChild(input);
      }
      document.body.appendChild(form);
      form.submit();
    };
  }
</script>
<% } %>
</body>
</html>
