<% var title = t('settings.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main>
  <p><a href="/account">&larr; <%= t('settings.back') %></a></p>
  <h1 class="page-title"><%= t('settings.title') %></h1>

  <% if (newToken) { %>
  <div class="card">
    <strong><%= t('account.new_token_created') %></strong> <%= t('account.new_token_copy') %>
    <code class="token"><%= newToken %></code>
  </div>
  <% } %>

  <div class="card">
    <h2 style="margin-top:0"><%= t('account.tokens_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('account.tokens_help_pre') %> <code>Authorization: Bearer &lt;token&gt;</code> <%= t('account.tokens_help_mid') %> <code>POST /api/import</code>.</p>
    <% if (tokens.length > 0) { %>
    <table>
      <tr><th><%= t('account.label') %></th><th><%= t('account.created') %></th><th><%= t('account.last_used') %></th><th></th></tr>
      <% tokens.forEach(function(tok) { %>
      <tr>
        <td><%= tok.label || t('account.no_label') %></td>
        <td><%= new Date(tok.created_at).toLocaleDateString(dateLocale) %></td>
        <td><%= tok.last_used_at ? new Date(tok.last_used_at).toLocaleDateString(dateLocale) : t('account.never') %></td>
        <td>
          <form method="post" action="/account/tokens/<%= tok.id %>/revoke" onsubmit="return confirm('<%= t('account.revoke_confirm') %>')">
            <button type="submit" class="danger"><%= t('account.revoke') %></button>
          </form>
        </td>
      </tr>
      <% }) %>
    </table>
    <% } %>
    <form method="post" action="/account/tokens" style="margin-top:1.2em; display:flex; gap:0.6em; flex-wrap:wrap;">
      <input type="text" name="label" placeholder="<%= t('account.token_label_placeholder') %>" style="flex:1; min-width:200px;">
      <button type="submit"><%= t('account.new_token') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('account.language_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('account.language_help') %></p>
    <form method="post" action="/account/locale" style="display:flex; gap:0.6em; flex-wrap:wrap; align-items:center;">
      <select name="locale">
        <option value="" <%= !storedLocale ? 'selected' : '' %>><%= t('account.language_auto') %></option>
        <% SUPPORTED_LOCALES.forEach(function(loc) { %>
        <option value="<%= loc %>" <%= storedLocale === loc ? 'selected' : '' %>><%= loc === 'nl' ? 'Nederlands' : 'English' %></option>
        <% }) %>
      </select>
      <button type="submit"><%= t('account.language_save') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.password_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('settings.password_help', { min: 12 }) %></p>
    <% if (passwordError) { %><p style="color:var(--danger)"><%= passwordError %></p><% } %>
    <% if (passwordSuccess) { %><p style="color:var(--accent)"><%= t('settings.password_success') %></p><% } %>
    <form method="post" action="/account/password" style="display:flex; flex-direction:column; gap:0.6em; max-width:320px;">
      <input type="password" name="current_password" placeholder="<%= t('settings.password_current') %>" autocomplete="current-password" required>
      <input type="password" name="new_password" placeholder="<%= t('settings.password_new') %>" autocomplete="new-password" required minlength="12">
      <input type="password" name="new_password2" placeholder="<%= t('settings.password_confirm') %>" autocomplete="new-password" required minlength="12">
      <button type="submit"><%= t('settings.password_save') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.batch_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('settings.batch_help') %></p>
    <form method="post" action="/account/settings/review-batch-size" style="display:flex; gap:0.6em; align-items:center;">
      <input type="number" name="size" min="1" max="50" value="<%= reviewBatchSize %>" style="width:6em;">
      <button type="submit"><%= t('settings.batch_save') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.reminders_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('settings.reminders_help') %></p>
    <form method="post" action="/account/settings/reminder-frequency" style="display:flex; gap:0.6em; align-items:center; flex-wrap:wrap;">
      <select name="hours">
        <option value="0" <%= reminderFrequencyHours === 0 ? 'selected' : '' %>><%= t('settings.frequency_never') %></option>
        <option value="24" <%= reminderFrequencyHours === 24 ? 'selected' : '' %>><%= t('settings.frequency_daily') %></option>
        <option value="48" <%= reminderFrequencyHours === 48 ? 'selected' : '' %>><%= t('settings.frequency_2days') %></option>
        <option value="72" <%= reminderFrequencyHours === 72 ? 'selected' : '' %>><%= t('settings.frequency_3days') %></option>
        <option value="168" <%= reminderFrequencyHours === 168 ? 'selected' : '' %>><%= t('settings.frequency_weekly') %></option>
      </select>
      <button type="submit"><%= t('settings.frequency_save') %></button>
    </form>

    <form method="post" action="/account/settings/reminder-hour" style="display:flex; gap:0.6em; align-items:center; flex-wrap:wrap; margin-top:0.8em;">
      <label style="font-size:0.85em; color:var(--text-dim); font-weight:600;"><%= t('settings.reminder_time_label') %>
        <select name="hour" style="display:block; margin-top:0.3em;">
          <% for (let h = 0; h < 24; h++) { %>
          <option value="<%= h %>" <%= reminderHour === h ? 'selected' : '' %>><%= String(h).padStart(2,'0') %>:00</option>
          <% } %>
        </select>
      </label>
      <button type="submit"><%= t('settings.reminder_time_save') %></button>
    </form>

    <div id="push-status" style="margin-top:1.2em; font-size:0.9em; color:var(--text-dim);"></div>
    <p style="margin-top:0.8em;">
      <button type="button" id="push-toggle" class="secondary"></button>
    </p>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.text_size_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('settings.text_size_help') %></p>
    <form method="post" action="/account/settings/text-scale" style="display:flex; gap:0.6em; align-items:center;">
      <select name="scale">
        <option value="0.7" <%= textScale === 0.7 ? 'selected' : '' %>><%= t('settings.text_size_xsmall') %></option>
        <option value="0.85" <%= textScale === 0.85 ? 'selected' : '' %>><%= t('settings.text_size_small') %></option>
        <option value="1" <%= textScale === 1 ? 'selected' : '' %>><%= t('settings.text_size_normal') %></option>
        <option value="1.15" <%= textScale === 1.15 ? 'selected' : '' %>><%= t('settings.text_size_large') %></option>
        <option value="1.3" <%= textScale === 1.3 ? 'selected' : '' %>><%= t('settings.text_size_xlarge') %></option>
      </select>
      <button type="submit"><%= t('settings.text_size_save') %></button>
    </form>
  </div>

  <script>
    const VAPID_PUBLIC_KEY = <%- JSON.stringify(vapidPublicKey) %>;
    const S = <%- JSON.stringify({
        notSupported: t('settings.push_not_supported'), enable: t('settings.push_enable'),
        disable: t('settings.push_disable'), enabled: t('settings.push_enabled'), denied: t('settings.push_denied'),
    }) %>;
    let subscribed = <%- pushSubscribed ? 'true' : 'false' %>;

    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const raw = atob(base64);
      return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
    }

    const statusEl = document.getElementById('push-status');
    const toggleEl = document.getElementById('push-toggle');

    function renderState() {
      if (!('serviceWorker' in navigator) || !('PushManager' in window) || !VAPID_PUBLIC_KEY) {
        statusEl.textContent = S.notSupported;
        toggleEl.style.display = 'none';
        return;
      }
      if (Notification.permission === 'denied') {
        statusEl.textContent = S.denied;
        toggleEl.style.display = 'none';
        return;
      }
      statusEl.textContent = subscribed ? S.enabled : '';
      toggleEl.textContent = subscribed ? S.disable : S.enable;
    }

    async function enablePush() {
      const registration = await navigator.serviceWorker.register('/sw.js');
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') { renderState(); return; }
      const sub = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY),
      });
      await fetch('/account/push-subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sub.toJSON()),
      });
      subscribed = true;
      renderState();
    }

    async function disablePush() {
      const registration = await navigator.serviceWorker.getRegistration('/sw.js');
      const sub = await registration?.pushManager.getSubscription();
      if (sub) {
        await fetch('/account/push-unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint }),
        });
        await sub.unsubscribe();
      }
      subscribed = false;
      renderState();
    }

    toggleEl.onclick = () => (subscribed ? disablePush() : enablePush());
    renderState();
  </script>
</main>
</body>
</html>
