<% var title = t('discover.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<style>
  .discover-feed { max-width:640px; margin:0 auto; padding:1em 1.2em 4em; display:flex; flex-direction:column; gap:1.2em; }
  .discover-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); box-shadow:var(--shadow); padding:1.8em 1.6em; }
  .discover-card .book-line-row { display:flex; align-items:center; gap:0.7em; margin-bottom:1.2em; }
  .discover-card .discover-cover { width:36px; aspect-ratio:2/3; object-fit:cover; border-radius:4px; flex-shrink:0; background:var(--surface-hover); }
  .discover-card .book-line { font-size:0.85em; color:var(--text-dim); }
  .discover-card .text { font-family: Georgia, 'Times New Roman', serif; font-size:calc(1.3rem * var(--text-scale)); line-height:1.5; color:var(--text); }
  .discover-card .note { margin-top:1em; font-size:0.95em; color:var(--text-dim); font-style:italic; }
  .discover-card .card-icons { display:flex; gap:1em; margin-top:1.5em; padding-top:1.1em; border-top:1px solid var(--border); }
  .discover-card .card-icons button { display:flex; align-items:center; justify-content:center; background:none; border:none; color:var(--text-faint); cursor:pointer; padding:0.3em; line-height:0; }
  .discover-card .card-icons button:hover { color:var(--text); }
  .discover-card .card-icons svg { width:1.15em; height:1.15em; display:block; }
  .discover-loader { text-align:center; color:var(--text-faint); padding:1.5em; font-size:0.9em; }
  .discover-empty { max-width:480px; margin:auto; text-align:center; padding:2em 1.2em; }
</style>
</head>
<body>
<main style="padding:0;">
  <% if (initialCards.length === 0) { %>
  <div class="discover-empty">
    <h2><%= t('discover.empty_heading') %></h2>
    <p style="color:var(--text-dim)"><%= t('discover.empty_body') %></p>
  </div>
  <% } else { %>
  <div class="discover-feed" id="feed"></div>
  <div class="discover-loader" id="loader"><%= t('discover.loading') %></div>
  <% } %>
</main>

<script>
  // Same escape-the-closing-script-tag guard as review.ejs's inline batch
  // (see that file's comment for why -- never spell the raw sequence out
  // here either).
  const S = <%- JSON.stringify({
      shareTitle: t('review.share_title'), bookTitle: t('review.book_title'),
      editTitle: t('review.edit_title'), editSave: t('book.save'), editCancel: t('book.cancel'),
      editTextPlaceholder: t('book.text_placeholder'), editNotePlaceholder: t('book.note_placeholder'),
  }).replace(/</g, '\\u003c') %>;
  let cards = <%- JSON.stringify(initialCards).replace(/</g, '\\u003c') %>;
  const seen = new Set();
  let loading = false;
  let exhausted = cards.length === 0;

  const ICON_SHARE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 8l5-5 5 5"/><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>';
  const ICON_BOOK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>';
  const ICON_EDIT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>';

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  const feed = document.getElementById('feed');
  const loader = document.getElementById('loader');

  // Counts a card only once you've actually scrolled PAST it, not the
  // moment it appears -- track every card that was ever visible, then fire
  // the review POST when it exits off the TOP of the viewport (scrolled
  // down past it). Exiting off the bottom (scrolled back up away from it)
  // does not count.
  const wasVisible = new Set();
  const seenObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const id = Number(entry.target.dataset.id);
      if (entry.isIntersecting) {
        wasVisible.add(id);
        return;
      }
      if (!wasVisible.has(id) || seen.has(id)) return;
      if (entry.boundingClientRect.top >= 0) return; // exited off the bottom, not read past
      seen.add(id);
      // Fire-and-forget: scrolling past it in Discover reschedules it
      // exactly like tapping "Volgende" in a normal review session.
      fetch('/review/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'action=next',
      }).catch(() => {});
    });
  }, { threshold: [0, 0.6] }) : null;

  const loadMoreObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '400px' }) : null;

  function fillCard(el, c) {
    el.innerHTML =
      '<div class="book-line-row">' +
      (c.coverUrl ? '<img class="discover-cover" src="' + esc(c.coverUrl) + '" alt="">' : '') +
      '<div class="book-line">' + c.bookTitleHtml + (c.bookAuthorHtml ? ' — ' + c.bookAuthorHtml : '') + '</div>' +
      '</div>' +
      '<div class="text">' + c.textHtml + '</div>' +
      (c.noteHtml ? '<div class="note">📝 ' + c.noteHtml + '</div>' : '') +
      '<div class="card-icons">' +
      '<button title="' + esc(S.shareTitle) + '" data-act="share">' + ICON_SHARE + '</button>' +
      '<button title="' + esc(S.bookTitle) + '" data-act="book">' + ICON_BOOK + '</button>' +
      '<button title="' + esc(S.editTitle) + '" data-act="edit">' + ICON_EDIT + '</button>' +
      '</div>';
    el.querySelector('[data-act=share]').onclick = () => location.href = '/highlights/' + c.id + '/share';
    el.querySelector('[data-act=book]').onclick = () => location.href = '/books/' + c.book_id + '#highlight-' + c.id;
    el.querySelector('[data-act=edit]').onclick = () => enterEditMode(el, c);
  }

  function renderCard(c) {
    const el = document.createElement('div');
    el.className = 'discover-card';
    el.dataset.id = c.id;
    fillCard(el, c);
    feed.appendChild(el);
    if (seenObserver) seenObserver.observe(el);
  }

  // Same inline-editing as review.ejs (see that comment for the reasoning),
  // here per-card instead of one global #card -- the discover feed shows
  // multiple cards at once after all.
  function enterEditMode(el, c) {
    el.innerHTML =
      '<div class="book-line-row">' +
      (c.coverUrl ? '<img class="discover-cover" src="' + esc(c.coverUrl) + '" alt="">' : '') +
      '<div class="book-line">' + c.bookTitleHtml + (c.bookAuthorHtml ? ' — ' + c.bookAuthorHtml : '') + '</div>' +
      '</div>' +
      '<textarea class="edit-text" rows="6" style="width:100%; font-family:Georgia, \'Times New Roman\', serif;" placeholder="' + esc(S.editTextPlaceholder) + '"></textarea>' +
      '<textarea class="edit-note" rows="2" style="width:100%; margin-top:0.6em;" placeholder="' + esc(S.editNotePlaceholder) + '"></textarea>' +
      '<div class="card-icons" style="justify-content:flex-end; gap:0.6em;">' +
      '<button type="button" class="secondary" data-act="cancel" style="width:auto; padding:0.5em 1em;">' + esc(S.editCancel) + '</button>' +
      '<button type="button" data-act="save" style="width:auto; padding:0.5em 1em;">' + esc(S.editSave) + '</button>' +
      '</div>';
    el.querySelector('.edit-text').value = c.text;
    el.querySelector('.edit-note').value = c.note || '';
    el.querySelector('[data-act=cancel]').onclick = () => fillCard(el, c);
    el.querySelector('[data-act=save]').onclick = async () => {
      const text = el.querySelector('.edit-text').value;
      const note = el.querySelector('.edit-note').value;
      if (!text.trim()) return;
      const res = await fetch('/highlights/' + c.id + '/edit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, note }),
      });
      if (!res.ok) return;
      const updated = await res.json();
      c.text = updated.text;
      c.note = updated.note;
      c.textHtml = updated.textHtml;
      c.noteHtml = updated.noteHtml;
      fillCard(el, c);
    };
  }

  async function loadMore() {
    if (loading || exhausted) return;
    loading = true;
    loader.style.display = 'block';
    try {
      const ids = cards.map((c) => c.id).join(',');
      const res = await fetch('/api/discover?exclude=' + encodeURIComponent(ids));
      const data = await res.json();
      if (data.cards.length === 0) {
        exhausted = true;
        loader.style.display = 'none';
        return;
      }
      cards = cards.concat(data.cards);
      data.cards.forEach(renderCard);
    } catch (e) {
      // Silently give up for this scroll -- the loader sentinel stays in
      // view so the next scroll tick just retries.
    } finally {
      loading = false;
    }
  }

  if (cards.length > 0) {
    cards.forEach(renderCard);
    if (loadMoreObserver) loadMoreObserver.observe(loader);
  }
</script>
</body>
</html>
